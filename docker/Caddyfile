# Caddyfile — static SPA serving for agence3terres
# Caddy listens on :80 by default; TLS is handled by your reverse proxy (Pangolin)
:80 {
	# Serve static files from /srv
	root * /srv

	# Routing: serve the real prerendered page for each route
	#   /services   → /services/index.html
	#   /projet7    → /projet7/index.html
	# then fall back to the root shell for any unknown client-side route.
	# Serving the exact prerendered file (instead of always the root shell)
	# keeps each page's <head>/meta correct and avoids relying on a directory
	# redirect that would append a trailing slash.
	# Serve the exact prerendered page for known routes; for anything unknown,
	# fall back to the SPA shell (200.html) so the client router can render the
	# 404 / error page (+error.svelte) instead of the home page.
	try_files {path} {path}/index.html {path}.html /200.html
	file_server

	# ── Security headers ────────────────────────────────────────
	header {
		# Prevent clickjacking
		X-Frame-Options "SAMEORIGIN"

		# Prevent MIME-type sniffing
		X-Content-Type-Options "nosniff"

		# Control referrer information
		Referrer-Policy "strict-origin-when-cross-origin"

		# Permissions policy — disable unnecessary browser features
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"

		# CSP — tailored to this app's actual requirements:
		#   - style-src 'unsafe-inline': GSAP sets inline styles (transform, opacity, filter)
		#     on every animated element. This is GSAP's core mechanism — no workaround exists.
		#     Svelte also injects <style> tags and uses style= attributes.
		#   - fonts.googleapis.com / fonts.gstatic.com: Google Fonts loaded via @import in components
		#   - images.unsplash.com / cdn.prod.website-files.com: external images used in galleries
		#   - script-src 'unsafe-inline': SvelteKit injects an inline <script> block in the
		#     prerendered HTML to bootstrap the app (__sveltekit_* globals). Without this,
		#     the browser blocks it and the page stays blank. No nonce-based alternative
		#     exists without a server-side rendering layer (this app is fully static/SSG).
		#   - No unsafe-eval needed
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://images.unsplash.com https://cdn.prod.website-files.com; connect-src 'self' https://fonts.googleapis.com https://fonts.gstatic.com"

		# Remove server identity header
		-Server
	}

	# ── Caching ─────────────────────────────────────────────────
	# Hashed assets (JS/CSS bundles from Vite) — immutable, long cache
	@hashed path /assets/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"

	# Images — served by stable filename (not content-hashed), so they can be
	# edited in place. Use revalidation instead of a long max-age: the browser
	# keeps the file cached but asks the server (via ETag) whether it changed.
	#   - unchanged → cheap 304, no re-download
	#   - edited    → new bytes served immediately (no stale 7-day copy)
	@images path /images/*
	header @images Cache-Control "public, no-cache"

	# HTML — never cache (ensures users get fresh SPA shell)
	@html path /
	header @html Cache-Control "no-cache, no-store, must-revalidate"

	# ── Block hidden files ──────────────────────────────────────
	@hidden path /.*
	respond @hidden 404

	# ── Compression ─────────────────────────────────────────────
	encode gzip zstd

	# ── Logging ─────────────────────────────────────────────────
	log {
		output stdout
		format console
	}
}
