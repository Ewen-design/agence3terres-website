# Caddyfile — static SPA serving for agence3terres
# Caddy listens on :80 by default; TLS is handled by your reverse proxy (Pangolin)
:80 {
	# Serve static files from /srv
	root * /srv

	# Routing — known routes: serve the exact prerendered page, then fall back to
	# the SPA shell (200.html) for any unknown client-side route.
	#   /services/  → /services/index.html
	#   /projet7/   → /projet7/index.html
	# Serving the exact prerendered file (instead of always the shell) keeps each
	# page's <head>/meta correct. The /200.html fallback is served with a 200 OK
	# status so the client router can render +error.svelte.
	#
	# NOTE: this is a deliberate "soft 200" — unknown URLs return 200, not a real
	# 404. We previously tried returning a real 404 (via handle_errors serving
	# 200.html), but the upstream Pangolin reverse proxy intercepts any 404 from
	# this origin and replaces the body with its own generic error page, so our
	# +error.svelte never reached the browser. Serving 200.html at 200 keeps our
	# own designed error page. To restore a real 404 status, Pangolin must be
	# configured to NOT intercept upstream error responses.
	try_files {path} {path}/index.html {path}.html /200.html
	file_server

	# ── Security headers ────────────────────────────────────────
	header {
		# Prevent clickjacking
		X-Frame-Options "SAMEORIGIN"

		# Prevent MIME-type sniffing
		X-Content-Type-Options "nosniff"

		# Control referrer information
		Referrer-Policy "strict-origin-when-cross-origin"

		# Permissions policy — disable unnecessary browser features
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"

		# CSP — tailored to this app's actual requirements:
		#   - style-src 'unsafe-inline': GSAP sets inline styles (transform, opacity, filter)
		#     on every animated element. This is GSAP's core mechanism — no workaround exists.
		#     Svelte also injects <style> tags and uses style= attributes.
		#   - fonts.googleapis.com / fonts.gstatic.com: Google Fonts loaded via @import in components
		#   - images.unsplash.com / cdn.prod.website-files.com: external images used in galleries
		#   - script-src 'unsafe-inline': SvelteKit injects an inline <script> block in the
		#     prerendered HTML to bootstrap the app (__sveltekit_* globals). Without this,
		#     the browser blocks it and the page stays blank. No nonce-based alternative
		#     exists without a server-side rendering layer (this app is fully static/SSG).
		#   - No unsafe-eval needed
		#   - media-src 'self': vidéos auto-hébergées (/videos/*). Couvert par
		#     default-src, mais explicité pour que l'intention reste lisible.
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://images.unsplash.com https://cdn.prod.website-files.com; media-src 'self'; connect-src 'self' https://fonts.googleapis.com https://fonts.gstatic.com"

		# Remove server identity header
		-Server
	}

	# ── Caching ─────────────────────────────────────────────────
	# Content-hashed assets (JS/CSS bundles from Vite) — immutable, long cache.
	# SvelteKit + Vite emit these under /_app/immutable/* (filenames carry a hash,
	# so a changed file gets a new URL — safe to cache forever).
	@hashed path /_app/immutable/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"

	# Images — served by stable filename (not content-hashed).
	# 2026-10-20 : on est passé de `no-cache` (revalidation à CHAQUE affichage,
	# donc un aller-retour serveur par image et par chargement de page, à travers
	# Pangolin) à un cache frais d'un jour + `stale-while-revalidate` d'une
	# semaine : dans la journée l'image sort du cache sans rien demander, ensuite
	# elle s'affiche tout de suite et la revalidation (304) se fait en fond.
	#   ⚠️ Conséquence : une image remplacée SOUS LE MÊME NOM peut rester
	#   l'ancienne jusqu'à un jour (+ un affichage). La règle du projet tient
	#   déjà compte de ça : nouveau nom de fichier, ou jeton `?v=` incrémenté
	#   sur toutes les références (l'URL change, le cache est contourné).
	# Les dégradés (/degrades/*) suivent la même règle (avant : aucun en-tête).
	@images path /images/* /degrades/*
	header @images Cache-Control "public, max-age=86400, stale-while-revalidate=604800"

	# Vidéos — même logique que les images (nom de fichier stable → revalidation
	# via ETag plutôt qu'un long max-age, pour qu'un ré-encodage soit servi tout
	# de suite). file_server gère nativement les requêtes Range, indispensables
	# pour que Safari accepte de démarrer la lecture.
	# Note : `encode` ne compresse que les types texte par défaut — les .mp4
	# passent donc en clair, ce qui est voulu (le gzip casserait le Range).
	@videos path /videos/*
	header @videos Cache-Control "public, no-cache"

	# HTML — never cache (ensures users get fresh SPA shell)
	@html path /
	header @html Cache-Control "no-cache, no-store, must-revalidate"

	# ── Block hidden files ──────────────────────────────────────
	@hidden path /.*
	respond @hidden 404

	# ── Compression ─────────────────────────────────────────────
	encode gzip zstd

	# ── Logging ─────────────────────────────────────────────────
	log {
		output stdout
		format console
	}
}
